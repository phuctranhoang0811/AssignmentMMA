# Public backend URL only. On a physical phone, use your backend's LAN IP or HTTPS URL.
EXPO_PUBLIC_API_URL=http://localhost:3001
# Android Emulator reaches the host computer through 10.0.2.2.
# For a physical Android phone, use the computer's LAN IP or an HTTPS backend URL.
EXPO_PUBLIC_ANDROID_API_URL=http://10.0.2.2:3001

# Enable the Ahamove staging checkout after configuring backend/.env.
EXPO_PUBLIC_DELIVERY_PROVIDER=ahamove

# Google OAuth IDs from the SAME Firebase/Google Cloud project (public IDs, never Client Secret).
# OAuth client type Web application, used to request the native Google ID token.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# iOS only: OAuth client type iOS. Android does not use this ID.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
IOS_BUNDLE_IDENTIFIER=
# Expo Go only: HTTPS origin of the backend serving /auth/google (no trailing slash).
EXPO_PUBLIC_GOOGLE_BRIDGE_URL=

# Cloudinary image hosting (unsigned upload). Leave empty to fall back to base64/Firebase Storage.
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

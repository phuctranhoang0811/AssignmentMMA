PORT=3001
FIREBASE_PROJECT_ID=pizzastore-59bad
# Absolute path to a service account OUTSIDE the repository, or use ADC on your host.
GOOGLE_APPLICATION_CREDENTIALS=C:/secure/firebase-service-account.json
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
# Local Android Emulator. Use your public HTTPS backend URL for production/real phones.
PAYOS_RETURN_URL=http://10.0.2.2:3001/payment/return
PAYOS_CANCEL_URL=http://10.0.2.2:3001/payment/cancel
ALLOWED_ORIGINS=http://localhost:8081

# Ahamove v3 STAGING ONLY. Obtain a partner staging account first.
AHAMOVE_ENABLED=false
AHAMOVE_API_KEY=
AHAMOVE_ACCOUNT_MOBILE=
AHAMOVE_SERVICE_ID=SGN-BIKE
# Generate at least 32 random characters. Configure the same BEARER-TOKEN in Ahamove Portal.
AHAMOVE_WEBHOOK_SECRET=
# Firebase Auth UIDs allowed to operate the kitchen/dispatch API, comma-separated.
AHAMOVE_STAFF_UIDS=
# Real addresses used as demo pickup points. Default: demo-le-thanh-ton.
# Other choices: demo-ben-thanh, demo-saigon-centre. No affiliation with the restaurants.
AHAMOVE_DEMO_STORE_ID=demo-le-thanh-ton
# Optional overrides. Otherwise use the demo address/name and your staging account phone.
# AHAMOVE_PICKUP_ADDRESS=
# AHAMOVE_PICKUP_NAME=
# AHAMOVE_PICKUP_MOBILE=

# Optional Google Login bridge for Expo Go. Uncomment and fill together to enable.
# Use the public HTTPS origin of THIS backend; add its hostname in Firebase Authorized domains.
# GOOGLE_BRIDGE_ORIGIN=https://your-backend.example.com
# Firebase WEB app's public API key (not a service-account key or OAuth Client Secret).
# FIREBASE_WEB_API_KEY=
# FIREBASE_AUTH_DOMAIN=pizzastore-59bad.firebaseapp.com

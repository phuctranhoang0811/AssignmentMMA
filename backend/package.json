{
  "name": "pizza-payment-backend",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "webhook:register": "node --env-file=.env --import tsx src/registerWebhook.ts",
    "seed:catalog": "node --env-file=.env --import tsx src/seedCatalog.ts",
    "backfill:phones": "node --env-file=.env --import tsx src/backfillPhones.ts",
    "dev": "node --env-file=.env --import tsx --watch src/server.ts",
    "start": "node --env-file=.env --import tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts test/*.test.mjs"
  },
  "dependencies": {
    "@payos/node": "^2.0.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "firebase-admin": "^14.5.0",
    "nodemailer": "^10.2.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  }
}

# Payment backend image. Built from the repository root because the backend shares code with the app (src/utils, src/data).
FROM node:22-slim
WORKDIR /app
COPY backend/package.json backend/package-lock.json backend/
RUN npm --prefix backend ci --omit=dev
COPY backend backend
COPY src src
ENV NODE_ENV=production HOST=0.0.0.0
WORKDIR /app/backend
# Settings come from environment variables on the host (no .env file in the image).
CMD ["node", "--import", "tsx", "src/server.ts"]

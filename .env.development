# Shared team backend on Render (public URL, no secrets). Teammates need no other .env file.
# To use a backend on your own computer instead, set these in .env.development.local (not committed).
EXPO_PUBLIC_API_URL=https://pizza-fpt-backend.onrender.com
EXPO_PUBLIC_ANDROID_API_URL=https://pizza-fpt-backend.onrender.com

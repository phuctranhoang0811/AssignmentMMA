rules_version = '2';

// The backend (Admin SDK) bypasses these rules. The app may only:
// read the menu, read its own orders, and create/edit its own profile without touching role or points.
// Admins (role set in the Firebase Console or by another admin) also manage the menu, coupons and roles.
service cloud.firestore {
  match /databases/{database}/documents {

    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'USER');
    }

    // Keep in sync with ADMIN_ROLES in src/utils/staff.ts.
    function isAdmin() {
      return request.auth != null && myRole() in ['SUPER_ADMIN', 'ADMIN', 'STORE_MANAGER'];
    }

    // Keep in sync with canChangeRole() in src/utils/staff.ts: SUPER_ADMIN/ADMIN assign roles,
    // and only SUPER_ADMIN may grant or remove SUPER_ADMIN/ADMIN.
    function canSetRole(before, after) {
      let role = myRole();
      return role in ['SUPER_ADMIN', 'ADMIN']
        && after in ['USER', 'EMPLOYEE', 'ROLE_KITCHEN', 'ROLE_RIDER', 'STORE_MANAGER', 'ADMIN', 'SUPER_ADMIN', 'BLACKLISTED']
        && (role == 'SUPER_ADMIN' || !(before in ['SUPER_ADMIN', 'ADMIN'] || after in ['SUPER_ADMIN', 'ADMIN']));
    }

    // One account per phone number: a profile's phone must be claimed in phone_numbers by the same account
    // (in the same write). Empty means no number (Google accounts before they add one).
    function ownsPhone(phone, uid) {
      return phone == '' || getAfter(/databases/$(database)/documents/phone_numbers/$(phone)).data.uid == uid;
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin(); // initial catalog: `cd backend && npm run seed:catalog`
    }

    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{document} {
      // Opening hours and the pause switch are public so the app can show "closed" before checkout; the backend writes them.
      allow read: if true;
      allow write: if false;
    }

    match /audit_logs/{entry} {
      // Written by the backend only; admins read it in the app.
      allow read: if isAdmin();
      allow write: if false;
    }

    match /orders/{orderId} {
      // Orders are created and moved by the backend only (prices, status, payment, refunds).
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    match /phone_numbers/{phone} {
      // Free numbers and your own claim are readable; someone else's claim is not (that is how "taken" shows).
      allow get: if request.auth != null && (resource == null || resource.data.uid == request.auth.uid);
      allow create: if request.auth != null && phone.matches('^0[0-9]{9}$')
        && request.resource.data.keys().hasOnly(['uid']) && request.resource.data.uid == request.auth.uid;
      // Released only when the profile no longer uses it.
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('phone', '') != phone;
      allow list, update: if false;
    }

    match /users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.role == 'USER'
        && request.resource.data.rewardPoints == 0
        && request.resource.data.welcomePending == true
        && request.resource.data.emailVerified == false
        && ownsPhone(request.resource.data.get('phone', ''), uid);
      // The owner edits their profile; role, points, uid and the verification flags stay out of reach, and a new phone must be claimed.
      allow update: if request.auth != null && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'rewardPoints', 'uid', 'welcomePending', 'emailVerified', 'emailVerifiedAt'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['phone'])
          || ownsPhone(request.resource.data.get('phone', ''), uid));
      // Admins change roles only (never their own); reward points stay backend-only.
      allow update: if request.auth != null && request.auth.uid != uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'updatedAt'])
        && canSetRole(resource.data.get('role', 'USER'), request.resource.data.role);
      allow delete: if false;

      match /reward_gifts/{giftId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }
    }

    // payment_orders, payment_codes, payment_system, delivery_*, coupon_usages: backend only.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
